        <mxCell id="woutcome" value="Thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="1225" y="1010" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="wsuccess" value="success=true; tạo SIM orderId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="990" y="1125" width="290" height="65" as="geometry"/></mxCell>
