  <diagram id="race-mechanisms" name="4.2 Race Condition - 4 Mechanisms">
    <mxGraphModel dx="2000" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="r-title" value="4.2 LUỒNG NGĂN ÂM KHO — SO SÁNH 4 CƠ CHẾ (RACE CONDITION FLOW)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="r1"><mxGeometry x="330" y="20" width="1340" height="45" as="geometry"/></mxCell>
        <mxCell id="r-start" value="1.000 threads cùng mua một FlashSaleItem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="820" y="85" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="r-switch" value="LockMechanism?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="865" y="185" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="r-lane1" value="NO_LOCK — Negative control" style="swimlane;horizontal=1;startSize=42;rounded=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#B91C1C;" vertex="1" parent="r1"><mxGeometry x="30" y="330" width="440" height="810" as="geometry"/></mxCell>
        <mxCell id="r-lane2" value="FILE_LOCK — OS file lock" style="swimlane;horizontal=1;startSize=42;rounded=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0F766E;" vertex="1" parent="r1"><mxGeometry x="520" y="330" width="440" height="810" as="geometry"/></mxCell>
        <mxCell id="r-lane3" value="SYNCHRONIZED — JVM monitor" style="swimlane;horizontal=1;startSize=42;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="r1"><mxGeometry x="1010" y="330" width="440" height="810" as="geometry"/></mxCell>
        <mxCell id="r-lane4" value="OPTIMISTIC — version + retry" style="swimlane;horizontal=1;startSize=42;rounded=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#6D28D9;" vertex="1" parent="r1"><mxGeometry x="1500" y="330" width="470" height="810" as="geometry"/></mxCell>
        <mxCell id="n1" value="Đọc soldQty, version&#xa;KHÔNG giữ lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="90" y="400" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="n2" value="soldQty + qty ≤ limitedQty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="100" y="500" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="n3" value="soldQty += qty; version++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="90" y="615" width="320" height="65" as="geometry"/></mxCell>
        <mxCell id="n4" value="update() đọc lại và rewrite toàn bộ CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="80" y="710" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="n5" value="Nhiều thread ghi đè cùng soldQty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="80" y="810" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="n6" value="LOST UPDATE&#xa;Âm kho logic / vi phạm nhất quán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#B91C1C;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="70" y="910" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="n7" value="FAIL" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="130" y="1030" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="f1" value="Mở RandomAccessFile + FileChannel&#xa;channel.lock() toàn file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="570" y="400" width="340" height="75" as="geometry"/></mxCell>
        <mxCell id="f2" value="Giành được lock?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="600" y="505" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="ferr" value="OverlappingFileLockException&#xa;Fail-fast trong cùng JVM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="565" y="615" width="350" height="70" as="geometry"/></mxCell>
        <mxCell id="f3" value="Trong lock: đọc toàn file → parse → tìm item → kiểm tra kho" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="560" y="715" width="360" height="75" as="geometry"/></mxCell>
        <mxCell id="f4" value="soldQty += qty; version++&#xa;truncate + rewrite CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="570" y="820" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="f5" value="Release FileLock / FileChannel&#xa;(try-with-resources)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="580" y="920" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="f6" value="0% âm kho cho giao dịch thành công&#xa;Nhưng utilization thấp do fail-fast" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="565" y="1020" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="s1" value="Chờ và vào monitor của repository&#xa;(synchronized method)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1060" y="400" width="340" height="75" as="geometry"/></mxCell>
        <mxCell id="s2" value="Đọc item trong vùng tới hạn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1070" y="510" width="320" height="65" as="geometry"/></mxCell>
        <mxCell id="s3" value="soldQty + qty ≤ limitedQty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1080" y="610" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="s4" value="soldQty += qty; version++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1070" y="730" width="320" height="65" as="geometry"/></mxCell>
        <mxCell id="s5" value="update() + rewrite toàn bộ CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1070" y="830" width="320" height="65" as="geometry"/></mxCell>
        <mxCell id="s6" value="Nhả monitor; thread kế tiếp được vào" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1060" y="930" width="340" height="65" as="geometry"/></mxCell>
        <mxCell id="s7" value="SAFE — 0% âm kho, bán đủ tồn kho&#xa;Khuyến nghị cho một JVM" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1055" y="1025" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="p1" value="attempt = 1; đọc item và versionDoc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1560" y="400" width="350" height="70" as="geometry"/></mxCell>
