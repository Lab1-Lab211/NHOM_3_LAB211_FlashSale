  <diagram id="data-generator" name="4.4 Generate CSV Data">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="d0"/>
        <mxCell id="d1" parent="d0"/>
        <mxCell id="d-title" value="4.4 LUỒNG GENERATE DATA CSV (≥ 10.000 DÒNG)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="d1"><mxGeometry x="350" y="20" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="d-start" value="START DataGenerator.main()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="720" y="85" width="360" height="65" as="geometry"/></mxCell>
        <mxCell id="d-init" value="Ghi nhận startTime; tạo thư mục data/&#xa;Random seed = 42 để tái tạo dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="d1"><mxGeometry x="650" y="185" width="500" height="75" as="geometry"/></mxCell>
        <mxCell id="d-help" value="Mỗi bước: sinh List entity → ghi UTF-8 BOM + header + từng dòng CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="525" y="290" width="750" height="55" as="geometry"/></mxCell>
        <mxCell id="d-prod" value="1. Sinh 5.000 Product&#xa;→ products.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="70" y="400" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="d-cust" value="2. Sinh 2.000 Customer&#xa;→ customers.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="420" y="400" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="d-event" value="3. Sinh 20 FlashSaleEvent&#xa;→ flash_events.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="770" y="400" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="d-item" value="4. Sinh 500 FlashSaleItem&#xa;FK: event + product&#xa;→ flash_items.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1120" y="400" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="d-order" value="5. Sinh 2.500 Order&#xa;FK: customer + event&#xa;→ orders.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1470" y="400" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="d-detail" value="6. Sinh 2.500 OrderDetail&#xa;FK: order + flash item&#xa;→ order_details.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="750" y="560" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="d-sum" value="Tổng dòng = 5.000 + 2.000 + 20 + 500 + 2.500 + 2.500 = 12.520" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="520" y="700" width="760" height="70" as="geometry"/></mxCell>
        <mxCell id="d-threshold" value="Tổng ≥ 10.000?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="760" y="805" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="d-failcount" value="FAIL yêu cầu dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1310" y="815" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="d-round" value="Round-trip test: lấy tối đa 100 mẫu mỗi entity&#xa;toCsvLine() → fromCsvLine() → so sánh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="d1"><mxGeometry x="620" y="930" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="d-errors" value="Có lỗi parse/serialize?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="760" y="1045" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="d-reporterr" value="In số lỗi và entity lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;" vertex="1" parent="d1"><mxGeometry x="1310" y="1055" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="d-success" value="PASS — In số dòng từng file + total time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="650" y="1170" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="d-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="780" y="1275" width="240" height="65" as="geometry"/></mxCell>
