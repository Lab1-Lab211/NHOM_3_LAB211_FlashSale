        <mxCell id="p3" value="Trong optimisticWriteLock:&#xa;đọc current version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;" vertex="1" parent="r1"><mxGeometry x="1560" y="595" width="350" height="70" as="geometry"/></mxCell>
