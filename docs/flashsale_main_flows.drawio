  <diagram id="simulator-latch" name="4.3 Simulator Tool - CountDownLatch">
    <mxGraphModel dx="1800" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="c0"/>
        <mxCell id="c1" parent="c0"/>
        <mxCell id="c-title" value="4.3 LUỒNG SIMULATOR TOOL (COUNTDOWNLATCH)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="c1"><mxGeometry x="350" y="20" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="c-mainlane" value="MAIN / SIMULATOR SERVICE" style="swimlane;horizontal=1;startSize=45;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="c1"><mxGeometry x="60" y="90" width="790" height="1500" as="geometry"/></mxCell>
        <mxCell id="c-workerlane" value="N WORKER THREADS" style="swimlane;horizontal=1;startSize=45;rounded=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#6D28D9;" vertex="1" parent="c1"><mxGeometry x="950" y="90" width="790" height="1500" as="geometry"/></mxCell>
        <mxCell id="mstart" value="START runAll(flashItemId, threadCount, qty)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="250" y="160" width="410" height="65" as="geometry"/></mxCell>
        <mxCell id="mvalid" value="Input hợp lệ và đủ Customer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="300" y="255" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="merr" value="IllegalArgumentException&#xa;/ timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;" vertex="1" parent="c1"><mxGeometry x="75" y="365" width="200" height="65" as="geometry"/></mxCell>
        <mxCell id="mselect" value="Sắp xếp và chọn N customer&#xa;clear transactions.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="290" y="375" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="mloop" value="Lấy cơ chế tiếp theo trong LockMechanism.values()&#xa;resetAllSoldQty()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="250" y="475" width="410" height="75" as="geometry"/></mxCell>
        <mxCell id="mlatch" value="Tạo readyGate(N), startGate(1), doneGate(N)&#xa;newFixedThreadPool(N) + synchronizedList" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="240" y="580" width="430" height="75" as="geometry"/></mxCell>
        <mxCell id="msubmit" value="Submit N worker tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="305" y="685" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="mready" value="readyGate.await() — đợi tất cả worker sẵn sàng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="245" y="790" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="mrelease" value="actualStart = nanoTime()&#xa;startGate.countDown() — phát lệnh chạy đồng thời" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="240" y="895" width="430" height="75" as="geometry"/></mxCell>
        <mxCell id="mdone" value="doneGate.await() — đợi N worker hoàn tất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="260" y="1010" width="390" height="65" as="geometry"/></mxCell>
        <mxCell id="mmetrics" value="actualEnd; shutdown executor; saveAll transactions&#xa;Tính OK/Fail, sold, lost update, TPS, latency, total time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="220" y="1115" width="470" height="80" as="geometry"/></mxCell>
        <mxCell id="mmore" value="Còn cơ chế?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="335" y="1225" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="mfinal" value="So sánh với baseline SYNCHRONIZED&#xa;append simulation_results.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="230" y="1345" width="450" height="75" as="geometry"/></mxCell>
        <mxCell id="mend" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="335" y="1450" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="wready" value="readyGate.countDown()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="1185" y="690" width="320" height="65" as="geometry"/></mxCell>
